# Copy to .env and fill in your Atlas values.
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="anomaly_db"

# Optional ingestor settings
TELEMETRY_TTL_DAYS=7
SERVICE_NAME=ingestor_service

# --- Embeddings: managed by Atlas Vector Search (Voyage AI Automated Embedding) ---
# No API key needed — Atlas embeds text_content at index + query time. This must
# match the model set in the knowledge_vector autoEmbed index (Atlas UI).
VOYAGE_EMBED_MODEL=voyage-4-lite

# --- Chat / agent reasoning: DeepSeek (OpenAI-compatible endpoint) ------------
# The investigation agent uses langchain_openai.ChatOpenAI — the generic client
# for the OpenAI chat-completions wire format. It does NOT call OpenAI; DeepSeek
# implements that format, so the client just points at LLM_BASE_URL below.
LLM_BASE_URL=https://api.deepseek.com         # DeepSeek (https://platform.deepseek.com/api_keys)
LLM_API_KEY=                                  # DeepSeek API key
CHAT_MODEL=deepseek-v4-flash                  # DeepSeek model id

# --- LangSmith tracing (optional, for agent debugging) ---
# Leave false unless you set a key below — LangChain reads this var directly and
# will try (and fail, noisily) to export traces if it's true without a key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mongodb-anomaly-agent

# --- Agent dispatch (ingestor → agent worker) ---
# stub = print to stdout (no Redis). redis = XADD to stream for agent_worker.
AGENT_DISPATCH=redis
REDIS_URL=redis://localhost:6379/0
ANOMALY_CONSUMER_GROUP=agent-workers
ANOMALY_STREAM_MAXLEN=10000

# --- Hybrid severity-based queues ---
# Anomalies are routed to {prefix}:high|medium|low; the worker drains high first.
# Jobs that fail ANOMALY_MAX_RETRIES times are moved to {prefix}:dlq.
ANOMALY_STREAM_PREFIX=anomaly
ANOMALY_MAX_RETRIES=3

# --- Anomaly detection: rate-of-change + statistical (in addition to thresholds) ---
# Count-based windows (last N readings), since the pipeline runs intermittently.
ANOMALY_WINDOW_SIZE=20
# Rate-of-change: flag a reading that jumps > ANOMALY_ROC_PCT vs the previous one.
ANOMALY_ROC_ENABLED=true
ANOMALY_ROC_PCT=0.3
ANOMALY_ROC_MIN_BASELINE=0.001
# Statistical: flag a reading whose |z-score| vs the rolling baseline exceeds the threshold.
ANOMALY_STAT_ENABLED=true
ANOMALY_STAT_ZSCORE=3.0
ANOMALY_STAT_MIN_READINGS=8

# --- Agent worker (separate process: python -m agent_worker.main) ---
DATA_LAYER_BASE_URL=http://localhost:8000
AGENT_CONSUMER_NAME=worker-1
AGENT_CONSUMER_BLOCK_MS=20000

# --- OpenTelemetry / observability (optional) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Shared service name override for demos; keep default per-process if unset.
OTEL_SERVICE_NAME=
